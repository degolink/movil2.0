{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_VERCEL": "https://movil2-0.vercel.app",
        "EXPO_PUBLIC_API_URL": "https://movil2-0.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
